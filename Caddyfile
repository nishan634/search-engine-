# Production reverse proxy with automatic HTTPS. Set DOMAIN in .env (e.g. search.example.com).
{$DOMAIN} {
	encode gzip
	request_body {
		max_size 30MB
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
