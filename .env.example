# ---- Copy to .env and fill in. NEVER commit .env ----

# Production only (docker-compose.prod.yml): public hostname served by Caddy
# DOMAIN=search.example.com

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string      # python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SECURE_COOKIES=0                 # set to 1 behind HTTPS (required in production)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# PostgreSQL (host/redis are set by docker-compose)
POSTGRES_DB=personal_search
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# S3-compatible storage (MinIO locally; AWS S3 / R2 / B2 in production)
AWS_STORAGE_BUCKET_NAME=personal-search
AWS_ACCESS_KEY_ID=minioadmin-change-me
AWS_SECRET_ACCESS_KEY=change-me-too-long-secret
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=http://minio:9000   # leave unset for AWS S3
MAX_UPLOAD_MB=25

# LLM + embeddings  (openai = any OpenAI-compatible server, incl. Ollama; anthropic = chat only)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1      # Ollama: http://host.docker.internal:11434/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_SEND_DIMENSIONS=1                    # set 0 for servers that reject the "dimensions" parameter
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Web search  (brave | tavily)
WEB_SEARCH_PROVIDER=brave
BRAVE_API_KEY=
TAVILY_API_KEY=
WEB_SEARCH_CACHE_SECONDS=600

# Rate limits (DRF format)
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_AUTH=10/min
THROTTLE_AI=20/min
THROTTLE_SEARCH=60/min
THROTTLE_UPLOAD=20/min

# Celery
CELERY_CONCURRENCY=2
